# ──────────────────────────────────────────────
# PSYConnect MVP v1.1 - Variables de entorno
# ──────────────────────────────────────────────
# Copia este archivo como .env.local para desarrollo
# NUNCA subas .env o .env.local al repositorio

# Base de datos (Supabase, Neon, Vercel Postgres o cualquier Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# Si usas Supabase o Neon con connection pooling, añade también:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# En producción: https://tu-dominio.vercel.app

# ── Auth ─────────────────────────────────────
# Genera un secreto seguro: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-seguro-en-produccion"
AUTH_URL="http://localhost:3000"

# Admin credentials
# Emails separados por coma que pueden acceder al panel
ADMIN_EMAILS="tu@email.com"
# Contraseña del panel admin
ADMIN_PASSWORD="cambia-esto-en-produccion"

# ── Email (Resend) ────────────────────────────
# Obtén tu clave en https://resend.com
# Si está vacío, los emails se loguean en consola (modo desarrollo)
RESEND_API_KEY=""
TEAM_EMAIL="equipo@psyconnect.es"

# ── Analítica ─────────────────────────────────
# PostHog (opcional)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=""

# ── Supabase (si lo usas para auth o storage) ──
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
